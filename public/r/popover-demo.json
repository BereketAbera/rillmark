{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-demo",
  "title": "Popover example",
  "description": "Working Popover example.",
  "dependencies": [],
  "registryDependencies": [
    "@rillmark/theme",
    "@rillmark/utils",
    "@rillmark/button",
    "@rillmark/checkbox",
    "@rillmark/popover"
  ],
  "files": [
    {
      "path": "registry/rillmark/examples/popover-demo.tsx",
      "content": "\"use client\"\nimport { useState } from \"react\"\nimport { Button } from \"@/components/ui/button\"\nimport { Checkbox } from \"@/components/ui/checkbox\"\nimport { Popover, PopoverClose, PopoverContent, PopoverTrigger } from \"@/components/ui/popover\"\n\nexport default function ComponentDemo() {\n  const [completed, setCompleted] = useState(false)\n  return <Popover>\n    <PopoverTrigger asChild><Button variant=\"outline\">View options{completed ? \" · all projects\" : \" · active only\"}</Button></PopoverTrigger>\n    <PopoverContent aria-label=\"View options\" className=\"space-y-3\">\n      <p className=\"text-sm font-semibold\">Make room for what matters</p>\n      <label className=\"flex cursor-pointer items-center gap-2 text-sm\"><Checkbox checked={completed} onCheckedChange={(value) => setCompleted(value === true)} />Include completed projects</label>\n      <PopoverClose asChild><Button size=\"sm\">Done</Button></PopoverClose>\n    </PopoverContent>\n  </Popover>\n}\n",
      "type": "registry:component",
      "target": "@components/examples/popover-demo.tsx"
    }
  ],
  "type": "registry:example"
}