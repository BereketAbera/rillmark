{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "progress-demo",
  "title": "Progress example",
  "description": "Working Progress example.",
  "dependencies": [],
  "registryDependencies": [
    "@rillmark/theme",
    "@rillmark/utils",
    "@rillmark/button",
    "@rillmark/progress"
  ],
  "files": [
    {
      "path": "registry/rillmark/examples/progress-demo.tsx",
      "content": "\"use client\"\nimport { useState } from \"react\"\nimport { Button } from \"@/components/ui/button\"\nimport { Progress } from \"@/components/ui/progress\"\n\nexport default function ComponentDemo() {\n  const [reviewed, setReviewed] = useState(6)\n  return <div className=\"w-full max-w-sm space-y-4\">\n    <div className=\"flex justify-between gap-3 text-sm\"><span className=\"font-semibold\">Observation review</span><span>{reviewed} of 12</span></div>\n    <Progress aria-label=\"Observations reviewed\" value={reviewed} max={12} getValueLabel={(value, max) => `${value} of ${max} observations`} />\n    <Button variant=\"outline\" onClick={() => setReviewed(reviewed === 12 ? 0 : reviewed + 1)}>{reviewed === 12 ? \"Start another review\" : \"Review next observation\"}</Button>\n  </div>\n}\n",
      "type": "registry:component",
      "target": "@components/examples/progress-demo.tsx"
    }
  ],
  "type": "registry:example"
}