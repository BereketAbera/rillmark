{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "button-demo",
  "title": "Button example",
  "description": "Working Button example.",
  "dependencies": [],
  "registryDependencies": [
    "@rillmark/theme",
    "@rillmark/utils",
    "@rillmark/button"
  ],
  "files": [
    {
      "path": "registry/rillmark/examples/button-demo.tsx",
      "content": "\"use client\"\nimport { useState } from \"react\"\nimport { Button } from \"@/components/ui/button\"\n\nexport default function ComponentDemo() {\n  const [saved, setSaved] = useState(false)\n  return <div className=\"space-y-3\">\n    <div className=\"flex flex-wrap items-center gap-3\">\n      <Button onClick={() => setSaved(true)} disabled={saved}>{saved ? \"Changes saved\" : \"Save changes\"}</Button>\n      <Button variant=\"outline\" onClick={() => setSaved(false)}>Reset</Button>\n      <Button disabled variant=\"soft\">Waiting for access</Button>\n    </div>\n    <p role=\"status\" className=\"text-sm text-muted-foreground\">{saved ? \"Your preferences are up to date.\" : \"You have unsaved preferences.\"}</p>\n  </div>\n}\n",
      "type": "registry:component",
      "target": "@components/examples/button-demo.tsx"
    }
  ],
  "type": "registry:example"
}