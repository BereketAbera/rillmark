{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "icon-button-demo",
  "title": "IconButton example",
  "description": "Working IconButton example.",
  "dependencies": [
    "lucide-react@^1.67.0"
  ],
  "registryDependencies": [
    "@rillmark/theme",
    "@rillmark/utils",
    "@rillmark/icon-button"
  ],
  "files": [
    {
      "path": "registry/rillmark/examples/icon-button-demo.tsx",
      "content": "\"use client\"\nimport { useState } from \"react\"\nimport { Bookmark } from \"lucide-react\"\nimport { IconButton } from \"@/components/ui/icon-button\"\n\nexport default function ComponentDemo() {\n  const [saved, setSaved] = useState(false)\n  return <div className=\"flex items-center gap-3\">\n    <IconButton label={saved ? \"Remove bookmark\" : \"Bookmark project\"} variant={saved ? \"solid\" : \"outline\"} aria-pressed={saved} onClick={() => setSaved(!saved)}><Bookmark aria-hidden=\"true\" size={18} fill={saved ? \"currentColor\" : \"none\"} /></IconButton>\n    <span className=\"text-sm text-muted-foreground\">{saved ? \"In your collection\" : \"Keep this project close\"}</span>\n  </div>\n}\n",
      "type": "registry:component",
      "target": "@components/examples/icon-button-demo.tsx"
    }
  ],
  "type": "registry:example"
}