{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "button-group-demo",
  "title": "ButtonGroup example",
  "description": "Working ButtonGroup example.",
  "dependencies": [],
  "registryDependencies": [
    "@rillmark/theme",
    "@rillmark/utils",
    "@rillmark/button",
    "@rillmark/button-group"
  ],
  "files": [
    {
      "path": "registry/rillmark/examples/button-group-demo.tsx",
      "content": "\"use client\"\nimport { useState } from \"react\"\nimport { Button } from \"@/components/ui/button\"\nimport { ButtonGroup } from \"@/components/ui/button-group\"\n\nexport default function ComponentDemo() {\n  const [period, setPeriod] = useState(\"Week\")\n  return <div className=\"space-y-3\">\n    <ButtonGroup aria-label=\"Reporting period\">{[\"Week\", \"Month\", \"Year\"].map((item) => <Button key={item} variant={period === item ? \"solid\" : \"outline\"} aria-pressed={period === item} onClick={() => setPeriod(item)}>{item}</Button>)}</ButtonGroup>\n    <p role=\"status\" className=\"text-sm text-muted-foreground\">Showing this {period.toLowerCase()}’s activity.</p>\n  </div>\n}\n",
      "type": "registry:component",
      "target": "@components/examples/button-group-demo.tsx"
    }
  ],
  "type": "registry:example"
}