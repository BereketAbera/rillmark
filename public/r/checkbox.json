{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "checkbox",
  "title": "Checkbox",
  "description": "An independent choice, clearly marked.",
  "dependencies": [
    "radix-ui@^1.8.1"
  ],
  "registryDependencies": [
    "@rillmark/theme",
    "@rillmark/utils",
    "@rillmark/field"
  ],
  "files": [
    {
      "path": "registry/rillmark/ui/checkbox.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { Checkbox as CheckboxPrimitive } from \"radix-ui\"\nimport { cn } from \"@/lib/rillmark-utils\"\nimport { useFieldControl } from \"@/components/ui/field\"\n\nexport function Checkbox({ className, ...props }: React.ComponentProps<typeof CheckboxPrimitive.Root>) {\n  const control = useFieldControl(props)\n  return (\n    <CheckboxPrimitive.Root data-slot=\"checkbox\" {...props} {...control} className={cn(\"group inline-flex size-11 shrink-0 items-center justify-center rounded-xl outline-none transition-colors hover:bg-accent/60 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none\", className)}>\n      <span className=\"flex size-5 items-center justify-center rounded-[6px] rounded-tr-[2px] border border-input bg-card text-primary-foreground transition-colors group-aria-invalid:border-destructive group-data-[state=checked]:border-primary group-data-[state=checked]:bg-primary group-data-[state=indeterminate]:border-primary group-data-[state=indeterminate]:bg-primary motion-reduce:transition-none\">\n        <CheckboxPrimitive.Indicator className=\"flex items-center justify-center\">\n          <svg aria-hidden=\"true\" viewBox=\"0 0 16 16\" className=\"size-3.5 fill-none stroke-current stroke-2\"><path className=\"group-data-[state=indeterminate]:hidden\" d=\"m3 8 3 3 7-7\" /><path className=\"hidden group-data-[state=indeterminate]:block\" d=\"M3 8h10\" /></svg>\n        </CheckboxPrimitive.Indicator>\n      </span>\n    </CheckboxPrimitive.Root>\n  )\n}\n",
      "type": "registry:ui"
    }
  ],
  "type": "registry:ui"
}