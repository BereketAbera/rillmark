{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "allowImportingTsExtensions": false,
    "types": [
      "react",
      "react-dom"
    ],
    "incremental": false,
    "paths": {
      "@/components/ui/*": [
        "./src/ui/*"
      ],
      "@/lib/rillmark-utils": [
        "./src/lib/rillmark-utils.ts"
      ]
    }
  },
  "include": [
    "src/ui/**/*.tsx",
    "src/lib/**/*.ts"
  ],
  "exclude": [
    "dist"
  ]
}
