{
  "name": "rillmark",
  "version": "0.2.0",
  "description": "Expressive React components with a considered visual identity, accessible interactions and readable source.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://rillmark.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/BereketAbera/rillmark.git",
    "directory": "packages/rillmark"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./tailwind.css": "./tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js",
      "default": "./dist/ui/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "skills",
    "tailwind.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "radix",
    "tailwind"
  ]
}
